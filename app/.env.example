# NVIDIA NIM (required for Patent Advisor reasoning nodes and embeddings)
NVIDIA_API_KEY=
# Optional overrides:
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.1-70b-instruct
# LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=8192
# LLM_THINKING=false   # enable reasoning on models that support it (Nemotron 3, etc.)
# LLM_FALLBACK_MODELS=  # comma-separated NVIDIA models tried before Groq

# Groq fallback: used after every NVIDIA model fails (or alone if NVIDIA_API_KEY is unset)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TIMEOUT=120

# Defaults
# DEFAULT_JURISDICTION=india
# DEFAULT_LEGAL_SCOPE=domestic
# SECTION3_WEIGHT_D=0.35
# SECTION3_WEIGHT_E=0.30
# SECTION3_WEIGHT_P=0.35
# SECTION3_STATUTE_TOP_K=30   # candidates for focused Section 3 statute retrieval (domestic India)

# Retrieval backend: mock (fixtures) | qdrant (Qdrant dense + BM25 hybrid)
# Keep mock until you have run ingestion.
RETRIEVER_BACKEND=mock

# Qdrant Cloud (primary). QDRANT_MODE=local uses an embedded DB at QDRANT_PATH.
QDRANT_MODE=cloud
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=ayurdisha_legal_dev
# QDRANT_PATH=./qdrant_data

# Embeddings / reranking
# (nv-embedqa-e5-v5 and nv-rerankqa-mistral-4b-v3 are retired by NVIDIA)
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
# RERANKER_ENABLED=false

# BM25 corpus source: qdrant (rebuild from collection payloads) | file (BM25_DIR)
# BM25_SOURCE=qdrant
# BM25_DIR=./data/processed

# Web search for Product Review evidence: mock | serper | google_cse | tavily | none
#   serper     -> Google results via https://serper.dev (SERPER_API_KEY)
#   google_cse -> Google Programmable Search (GOOGLE_CSE_API_KEY + GOOGLE_CSE_ID)
#   tavily     -> https://tavily.com (TAVILY_API_KEY)
WEB_SEARCH_BACKEND=mock
# SERPER_API_KEY=
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=
# TAVILY_API_KEY=
# WEB_SEARCH_RESULTS=5
# WEB_SEARCH_TIMEOUT=15
# WEB_SEARCH_COUNTRY=in
# PRODUCT_REVIEW_MAX_RESOURCES=3

# Patent Advisor PDF upload (text layer first, local RapidOCR for scanned pages)
# PDF_MAX_BYTES=20971520
# PDF_MAX_PAGES=30
# PDF_OCR_ENABLED=true
# PDF_OCR_MIN_CHARS=50   # pages with less extracted text than this are OCR'd
# PDF_OCR_DPI=200
# PATENT_DOC_CONTEXT_CHARS=12000   # document characters passed into prompts

# Knowledge graph (Neo4j). Without NEO4J_URI an in-memory graph is used instead.
# Local: Neo4j Desktop / `docker run -p 7474:7474 -p 7687:7687 neo4j:5`; cloud: AuraDB (neo4j+s://...)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=          # blank = server default
# KG_AUTO_SEED=true        # seed curated herbs + corpus mentions at startup if the graph is empty
# KG_RECORD_RESPONSES=true # write each analysis (product, herbs, sources) into the graph
# KG_CORPUS_DIR=./data/raw/corpus

# BHASHINI (optional multilingual / voice layer). Without these, text input works in English
# and voice / translation are reported as unavailable. Credentials stay server-side.
# ULCA userID + ulcaApiKey from https://bhashini.gov.in/ulca (profile page).
# BHASHINI_ENABLED=false
# BHASHINI_USER_ID=
# BHASHINI_API_KEY=
# BHASHINI_BASE_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
# BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd   # pipeline to discover services from
# BHASHINI_DEFAULT_SOURCE_LANGUAGE=en
# BHASHINI_DEFAULT_TARGET_LANGUAGE=en
# Optional explicit service overrides (normally discovered per language pair):
# BHASHINI_ASR_SERVICE=
# BHASHINI_TRANSLATION_SERVICE=
# BHASHINI_TTS_SERVICE=
# BHASHINI_TIMEOUT=20
# AUDIO_MAX_BYTES=5242880

# Hybrid tuning
# RRF_K=60
# DENSE_CANDIDATES=30
# BM25_CANDIDATES=30
# RERANK_CANDIDATES=20

