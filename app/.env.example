# NVIDIA NIM (required for Patent Advisor reasoning nodes and embeddings)
NVIDIA_API_KEY=
# Optional overrides:
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.1-70b-instruct
# LLM_TEMPERATURE=0

# Defaults
# DEFAULT_JURISDICTION=india
# DEFAULT_LEGAL_SCOPE=domestic
# SECTION3_WEIGHT_D=0.35
# SECTION3_WEIGHT_E=0.30
# SECTION3_WEIGHT_P=0.35

# Retrieval backend: mock (fixtures) | qdrant (Qdrant dense + BM25 hybrid)
# Keep mock until you have run ingestion.
RETRIEVER_BACKEND=mock

# Qdrant Cloud (primary). QDRANT_MODE=local uses an embedded DB at QDRANT_PATH.
QDRANT_MODE=cloud
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=ayurdisha_legal_dev
# QDRANT_PATH=./qdrant_data

# Embeddings / reranking
# (nv-embedqa-e5-v5 and nv-rerankqa-mistral-4b-v3 are retired by NVIDIA)
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
# RERANKER_ENABLED=false

# BM25 corpus source: qdrant (rebuild from collection payloads) | file (BM25_DIR)
# BM25_SOURCE=qdrant
# BM25_DIR=./data/processed

# Web search for Product Review evidence: mock | serper | google_cse | tavily | none
#   serper     -> Google results via https://serper.dev (SERPER_API_KEY)
#   google_cse -> Google Programmable Search (GOOGLE_CSE_API_KEY + GOOGLE_CSE_ID)
#   tavily     -> https://tavily.com (TAVILY_API_KEY)
WEB_SEARCH_BACKEND=mock
# SERPER_API_KEY=
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=
# TAVILY_API_KEY=
# WEB_SEARCH_RESULTS=5
# WEB_SEARCH_TIMEOUT=15
# WEB_SEARCH_COUNTRY=in
# PRODUCT_REVIEW_MAX_RESOURCES=3

# Hybrid tuning
# RRF_K=60
# DENSE_CANDIDATES=30
# BM25_CANDIDATES=30
# RERANK_CANDIDATES=20
